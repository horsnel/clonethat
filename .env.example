# ---- Clonethat configuration (copy to .env and adjust) ----

# LLM provider used by the AI rebuild engine.
# Leave unset to use the built-in z.ai sandbox provider (local development).
# Set LLM_PROVIDER=openai (or just provide OPENAI_API_KEY) to use any
# OpenAI-compatible endpoint in production.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Artifact storage driver: local (filesystem, clones/) today; blob in Phase 2.
# STORAGE_DRIVER=local
# CLONES_DIR=/absolute/path/to/clones

# Ephemeral retention — clones are hard-deleted after this many hours.
RETENTION_HOURS=24

# Abuse protection (per IP, fixed window)
CLONE_RATE_LIMIT=10
REBUILD_RATE_LIMIT=20

# Serverless job backend (Phase 2 / Vercel). When set, job state lives in
# Upstash Redis instead of the local filesystem.
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
